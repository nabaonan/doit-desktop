{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "doit-desktop",
  "version": "0.1.8",
  "identifier": "com.doit.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "doit",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/nabaonan/doit-desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRDMDIxNDMwOUYxRjMyMzcKUldRM01oK2ZNQlFDVEptOERHQmRNc3JmZHZoMDcwbVEyUzVFK1IxQmtsUHQrZk9Kc2JYa2dSdUQK"
    }
  }
}
